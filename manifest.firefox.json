{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "1.5",
  "description": "__MSG_extDesc__",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "topSites",
    "https://api.xinac.net/*",
    "https://favicon.cccyun.cc/*",
    "https://firefox-settings-attachments.cdn.mozilla.net/*",
    "https://bing.xinac.net/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cheesetab@runningcheese.com",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
